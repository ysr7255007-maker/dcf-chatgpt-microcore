{
  "name": "dcf-surface",
  "version": "0.1.0",
  "description": "DCF Surface - Independent desktop sidebar for dialog control",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --mac",
    "build:dir": "electron-builder --mac --dir"
  },
  "build": {
    "appId": "com.dcf.surface",
    "productName": "DCF Surface",
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "identity": null
    },
    "files": [
      "src/**/*",
      "README.md"
    ],
    "extraResources": [
      {
        "from": "../../seed/surface",
        "to": "seed/surface"
      }
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    }
  },
  "devDependencies": {
    "electron": "^43.0.0",
    "electron-builder": "^26.0.0"
  }
}
