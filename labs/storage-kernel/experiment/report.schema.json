{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dcf.local/schemas/storage-lab-report-v1.json",
  "title": "DCF Storage Lab Experiment Report",
  "type": "object",
  "required": ["contract_version", "generated_at", "source_set_id", "runs"],
  "properties": {
    "contract_version": { "const": "dcf.storage-lab.contract.v1" },
    "generated_at": { "type": "string" },
    "source_set_id": { "type": "string", "minLength": 1 },
    "runs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/run" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "variant": {
      "enum": ["zh_clean", "hybrid_clean", "raw_json"]
    },
    "engine_kind": {
      "enum": [
        "utf8_self_index",
        "unicode_byte_aware_self_index",
        "utf8_locate_zstd",
        "unicode_locate_zstd"
      ]
    },
    "storage_component": {
      "type": "object",
      "required": ["name", "bytes"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "bytes": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "percentiles": {
      "type": "object",
      "required": ["samples", "p50_ms", "p95_ms", "min_ms", "max_ms"],
      "properties": {
        "samples": { "type": "integer", "minimum": 0 },
        "p50_ms": { "type": "number", "minimum": 0 },
        "p95_ms": { "type": "number", "minimum": 0 },
        "min_ms": { "type": "number", "minimum": 0 },
        "max_ms": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "window": {
      "type": "object",
      "required": ["window_bytes", "cache_state", "distribution", "timing"],
      "properties": {
        "window_bytes": { "type": "integer", "minimum": 0 },
        "cache_state": {
          "enum": ["application_hot", "application_cold_os_unspecified"]
        },
        "distribution": { "type": "string" },
        "timing": { "$ref": "#/$defs/percentiles" }
      },
      "additionalProperties": false
    },
    "run": {
      "type": "object",
      "required": [
        "contract_version",
        "run_id",
        "dataset_id",
        "source_set_id",
        "variant",
        "engine_id",
        "engine_kind",
        "capabilities",
        "correctness",
        "source_bytes",
        "storage_components",
        "storage_bytes_total",
        "bytes_per_input_byte",
        "window_benchmarks",
        "machine",
        "notes"
      ],
      "properties": {
        "contract_version": { "const": "dcf.storage-lab.contract.v1" },
        "run_id": { "type": "string" },
        "dataset_id": { "type": "string" },
        "source_set_id": { "type": "string" },
        "variant": { "$ref": "#/$defs/variant" },
        "engine_id": { "type": "string" },
        "engine_kind": { "$ref": "#/$defs/engine_kind" },
        "capabilities": { "type": "object" },
        "correctness": {
          "type": "object",
          "required": ["passed", "recovery_sha256_matches", "manifest_binding_matches", "query_results", "errors"],
          "properties": {
            "passed": { "type": "boolean" },
            "recovery_sha256_matches": { "type": "boolean" },
            "manifest_binding_matches": { "type": "boolean" },
            "query_results": { "type": "array" },
            "errors": { "type": "array", "items": { "type": "string" } }
          }
        },
        "source_bytes": { "type": "integer", "minimum": 0 },
        "storage_components": {
          "type": "array",
          "items": { "$ref": "#/$defs/storage_component" }
        },
        "storage_bytes_total": { "type": "integer", "minimum": 0 },
        "bytes_per_input_byte": { "type": "number", "minimum": 0 },
        "build_ms": { "type": ["number", "null"], "minimum": 0 },
        "open_ms": { "type": ["number", "null"], "minimum": 0 },
        "count_timing": { "anyOf": [{ "$ref": "#/$defs/percentiles" }, { "type": "null" }] },
        "locate_timing": { "anyOf": [{ "$ref": "#/$defs/percentiles" }, { "type": "null" }] },
        "window_benchmarks": {
          "type": "array",
          "items": { "$ref": "#/$defs/window" }
        },
        "full_recovery_ms": { "type": ["number", "null"], "minimum": 0 },
        "machine": { "type": "object" },
        "notes": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    }
  }
}
