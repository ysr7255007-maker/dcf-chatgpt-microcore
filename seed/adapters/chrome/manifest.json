{
  "manifest_version": 3,
  "name": "DCF Chrome Adapter - G1",
  "version": "0.1.0-g1",
  "description": "G1 Chrome adapter for observing ChatGPT conversations and sending events to Companion Core",
  "permissions": [
    "storage",
    "alarms",
    "tabs"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "http://127.0.0.1:8472/*",
    "http://localhost:8472/*",
    "https://doubao.com/*",
    "https://gemini.google.com/*",
    "https://grok.com/*",
    "https://kimi.com/*",
    "https://chat.z.ai/*",
    "https://deepseek.com/*",
    "https://agent.minimaxi.com/*",
    "https://aistudio.xiaomimimo.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://doubao.com/*",
        "https://gemini.google.com/*",
        "https://grok.com/*",
        "https://kimi.com/*",
        "https://chat.z.ai/*",
        "https://deepseek.com/*",
        "https://agent.minimaxi.com/*",
        "https://aistudio.xiaomimimo.com/*"
      ],
      "js": ["web-capture/bundle.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "DCF Chrome Adapter"
  },
  "minimum_chrome_version": "102"
}
